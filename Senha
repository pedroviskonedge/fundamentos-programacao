#include <stdio.h>

int senha; 
int i; // 

int main() { 
    int acertou = 0; 

    for (i = 1; i <= 3; i++) { 
        printf("\nDigite sua senha (Tentativa %d de 3): ", i); 
        scanf("%d", &senha); 
        
        if (senha == 123456) { 
            acertou = 1; 
            break;       
        } else {
            printf("Senha incorreta!\n");
        } 
    } 

    if (acertou) {
        printf("\nChega mais!\n"); 
    } else {
        printf("\n[BLOQUEADO] Voce errou a senha 3 vezes.\n");
    }

    return 0;
}
